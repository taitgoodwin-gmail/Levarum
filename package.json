    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "zod": "^3.24.0"
  },
  "engines": {
    "node": "24.x"
