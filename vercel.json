{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/designs",
      "destination": "/designs/index.html"
    },
    {
      "source": "/designs/",
      "destination": "/designs/index.html"
    },
    {
      "source": "/((?!api/|designs(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run build",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
