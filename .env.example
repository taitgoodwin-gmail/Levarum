# Server-only. Create a PRIVATE Blob store and connect it to this project.
# Pull the real value securely with `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=

# Optional notifications. Use a verified sender with your email provider.
# Leads are always saved privately before attempting notification.
RESEND_API_KEY=
LEAD_EMAIL_FROM=

# Standalone API port (Vercel supplies its own runtime).
PORT=8787
