# Server-side only. Never exposed to the browser: the key is read by the
# /api/draft handler, which is the single place that talks to the Claude API.
# Without it, drafts fall back to the deterministic offline draft and the
# console labels them "Offline draft" rather than pretending.
ANTHROPIC_API_KEY=

# The operator console's credential. Required for /operator to open at all —
# with these unset the console refuses every sign-in and says why, which is the
# safe failure for an unconfigured deployment. Checked in constant time on the
# server; the browser only ever receives a signed HttpOnly session cookie.
OPERATOR_USER=
OPERATOR_PASSWORD=

# Optional. Signs the session cookie. With this unset a stable secret is
# derived from OPERATOR_PASSWORD, which works and has the useful property that
# changing the password invalidates every outstanding session. Set it
# explicitly if you want sessions to survive a password change, or want the
# password out of the signing path.
SESSION_SECRET=

# Durable lead storage. Attach a Vercel KV (Upstash Redis) integration and
# these two appear automatically. With them set, POST /api/submit writes to KV
# and leads are visible from any device; without them the store falls back to
# the function's memory, which is fine for local development and honest about
# itself — the console says which backend is live rather than letting anyone
# assume a lead is durable when it is one cold start from gone.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional. Port for `npm run serve:api` (the standalone API for production
# hosts other than Vercel, or alongside `vite preview`). Defaults to 8787.
DRAFT_API_PORT=8787

# Optional. Set when the browser bundle is served from a different origin than
# the API. The session cookie rides these requests, so this cannot be a
# wildcard: name the exact origin.
# DRAFT_API_ORIGIN=https://levarum.co

# Optional. Point the browser at a draft endpoint on another origin.
# Leave unset to use the same-origin default of /api/draft.
# VITE_DRAFT_ENDPOINT=http://localhost:8787/api/draft
