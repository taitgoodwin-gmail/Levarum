# Server-only. Create a PRIVATE Blob store and connect it to this project.
# Pull the real value securely with `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=
# A separate private Blob store credential for preview/development.
PREVIEW_READ_WRITE_TOKEN=

# Private operator queue. Keep secret values server-side; the publishable key is public.
DATABASE_URL=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
ADMIN_OWNER_USER_ID=
ADMIN_OWNER_EMAIL=
ADMIN_ALLOWED_ORIGINS=

# Optional notifications. Use a verified sender with your email provider.
# Leads are always saved privately before attempting notification.
RESEND_API_KEY=
LEAD_EMAIL_FROM=

# Standalone API port (Vercel supplies its own runtime).
PORT=8787
