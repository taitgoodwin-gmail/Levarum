{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // This flag is why `npm run typecheck` passed while the deploy failed: it
    // made `.ts` specifiers legal here, and Vercel's emitting build cannot turn
    // it on. Left enabled for the tsx-run scripts, but tsconfig.vercel.json now
    // type-checks the same api/ tree without it, so the two can no longer
    // disagree in silence.
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts", "server", "api", "src/domain", "src/brand.ts"]
}
